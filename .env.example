# Скопируй в .env и заполни, чтобы читать события из Airtable.
# Токен нужен только на чтение (scope data.records:read) и только к одной базе:
# в статическом сайте он виден в коде страницы.
VITE_AIRTABLE_BASE_ID=
VITE_AIRTABLE_TOKEN=
VITE_AIRTABLE_TABLE=Events

# Ключ JavaScript API Яндекс Карт (кабинет разработчика: developer.tech.yandex.ru).
# Нужен только редактору темы карты (map-editor.html). Ключ попадает в код страницы,
# поэтому в кабинете ограничь его по HTTP Referer: localhost и hseadc.github.io.
VITE_YANDEX_MAPS_KEY=
